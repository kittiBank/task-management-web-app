# Docker Compose defaults (all optional — docker-compose.yml has fallbacks)
# Copy to .env only when you need to override values.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=task_management
POSTGRES_PORT=5432

PORT=3000
VITE_API_BASE_URL=http://localhost:3000
FRONTEND_PORT=5173

# Note: DATABASE_URL for Docker is built automatically inside docker-compose.yml
# using host "postgres" (Docker network). For local dev, use back-end/.env.example.
